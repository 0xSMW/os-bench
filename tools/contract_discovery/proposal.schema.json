{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osbench.dev/schema/contract-proposal.v1.json",
  "title": "OSBench AI Contract Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "evidence", "contract", "uncertainty", "review_state"],
  "properties": {
    "schema_version": {"const": "osbench.contract_proposal.v1"},
    "proposal_id": {"type": "string", "minLength": 8},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "reference"],
        "properties": {
          "kind": {"enum": ["trace", "documentation", "oracle_observation", "source", "nearby_contract"]},
          "reference": {"type": "string"},
          "excerpt": {"type": "string"},
          "sha256": {"type": "string"}
        }
      }
    },
    "contract": {"type": "object"},
    "uncertainty": {
      "type": "object",
      "required": ["confidence", "open_questions"],
      "properties": {
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "open_questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "review_state": {"enum": ["proposed", "oracle_validated", "stabilized", "human_reviewed", "accepted", "rejected"]}
  }
}
